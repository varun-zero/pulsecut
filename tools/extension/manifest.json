{
  "manifest_version": 3,
  "name": "PulseCut Auto-Clipper",
  "version": "1.1.0",
  "description": "Monitors Kick, Twitch, YouTube Live, YouTube Shorts, and Instagram Reels to detect chat hype spikes and trigger instant PulseCut clips.",
  "permissions": [
    "storage",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://*.kick.com/*",
    "https://*.twitch.tv/*",
    "https://*.youtube.com/*",
    "https://*.instagram.com/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PulseCut Auto-Clipper"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.kick.com/*",
        "https://*.twitch.tv/*",
        "https://*.youtube.com/watch*",
        "https://*.youtube.com/live/*",
        "https://*.youtube.com/live_chat*",
        "https://*.youtube.com/live_chat_replay*",
        "https://*.youtube.com/shorts/*",
        "https://*.instagram.com/*"
      ],
      "js": [
        "hypeEngine.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
